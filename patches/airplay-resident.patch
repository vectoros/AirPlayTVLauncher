@@ -0,0 +1,93 @@
+package io.github.jqssun.airplay;
+
+import android.app.Activity;
+import android.app.Instrumentation;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import io.github.jqssun.airplay.service.AirPlayService;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+
+/** Synthetic session tests. Does not pretend to validate an Apple sender or video decoding. */
+public final class AuroraRegressionInstrumentation extends Instrumentation {
+    private int checks;
+    private final StringBuilder report = new StringBuilder();
+    @Override public void onCreate(Bundle args) { super.onCreate(args); start(); }
+    @Override public void onStart() {
+        Bundle result = new Bundle(); int code = Activity.RESULT_OK;
+        try { testProjectionLifecycle(); }
+        catch (Throwable error) {
+            code = Activity.RESULT_CANCELED;
+            StringWriter trace = new StringWriter(); error.printStackTrace(new PrintWriter(trace));
+            report.append("FAIL ").append(trace);
+        }
+        result.putString("stream", "\n" + report + "Checks: " + checks + "\n");
+        finish(code, result);
+    }
+    private void testProjectionLifecycle() throws Exception {
+        Context ctx = getTargetContext();
+        Uri control = Uri.parse("content://dev.aurora.airplay.control");
+        Bundle original = ctx.getContentResolver().call(control, "status", null, null);
+        if (original.getBoolean("casting")) {
+            report.append("SKIP: an actual sender is active\n"); return;
+        }
+        Bundle restore = new Bundle(); restore.putBoolean("enabled", original.getBoolean("enabled"));
+        Activity initial = null, projected = null;
+        ActivityMonitor monitor = null;
+        try {
+            Bundle enabled = new Bundle(); enabled.putBoolean("enabled", true);
+            ctx.getContentResolver().call(control, "configure", null, enabled);
+            initial = startActivitySync(new Intent(ctx, MainActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            for (int i = 0; i < 100 && (service() == null || service().getServerState().getValue() != AirPlayService.ServerState.RUNNING); i++) Thread.sleep(100);
+            require(service() != null && service().getServerState().getValue() == AirPlayService.ServerState.RUNNING, "Receiver is running");
+            Activity advanced = initial; runOnMainSync(advanced::finish); initial = null;
+            waitForIdleSync(); Thread.sleep(400);
+            monitor = addMonitor(MainActivity.class.getName(), null, false);
+            runOnMainSync(() -> service().onConnectionInit());
+            require(monitor.waitForActivityWithTimeout(1200) == null, "A TCP probe never opens playback UI");
+            runOnMainSync(() -> service().onVideoSize(1920, 1080, 1920, 1080));
+            projected = monitor.waitForActivityWithTimeout(6000);
+            require(projected != null, "Real-session callback opens projection UI");
+            require(projected.getIntent().getComponent().getClassName().endsWith(".PlaybackActivity"), "Projection uses the private playback entry");
+            Activity playback = projected;
+            runOnMainSync(() -> service().onConnectionDestroy());
+            for (int i = 0; i < 60 && !playback.isFinishing() && !playback.isDestroyed(); i++) Thread.sleep(100);
+            require(playback.isFinishing() || playback.isDestroyed(), "Disconnect dismisses projection without showing settings");
+            require(service() != null && service().getServerState().getValue() == AirPlayService.ServerState.RUNNING, "Receiver stays ready after projection ends");
+            initial = startActivitySync(new Intent(ctx, MainActivity.class).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+            waitForIdleSync();
+            Bundle off = new Bundle(); off.putBoolean("enabled", false);
+            ctx.getContentResolver().call(control, "configure", null, off);
+            for (int i = 0; i < 60 && service().getServerState().getValue() != AirPlayService.ServerState.STOPPED; i++) Thread.sleep(100);
+            require(service().getServerState().getValue() == AirPlayService.ServerState.STOPPED, "Master off releases a receiver still bound to an Activity");
+            ctx.stopService(new Intent(ctx, AirPlayService.class));
+            Thread.sleep(600);
+            runOnMainSync(() -> new BootReceiver().onReceive(ctx, new Intent(Intent.ACTION_BOOT_COMPLETED)));
+            Thread.sleep(600);
+            require(!ctx.getContentResolver().call(control, "status", null, null).getBoolean("enabled"), "Boot respects the persisted off state");
+            require(service() == null || service().getServerState().getValue() == AirPlayService.ServerState.STOPPED, "Boot does not restart a disabled receiver");
+            ctx.startForegroundService(new Intent(ctx, AirPlayService.class).setAction(AirPlayService.ACTION_START_SERVER));
+            Thread.sleep(6500);
+            require(service() != null && service().getServerState().getValue() == AirPlayService.ServerState.STOPPED,
+                    "Rejected foreground start meets its deadline while bound");
+            runOnMainSync(() -> service().startServer(original.getString("name", "Aurora TV")));
+            for (int i = 0; i < 60 && service().getServerState().getValue() != AirPlayService.ServerState.RUNNING; i++) Thread.sleep(100);
+            require(ctx.getContentResolver().call(control, "status", null, null).getBoolean("enabled")
+                    && service().getServerState().getValue() == AirPlayService.ServerState.RUNNING, "Explicit advanced Start can re-enable the receiver");
+        } finally {
+            if (monitor != null) removeMonitor(monitor);
+            Activity a = initial, b = projected;
+            runOnMainSync(() -> { if (a != null) a.finish(); if (b != null) b.finish(); });
+            ctx.getContentResolver().call(control, "configure", null, restore);
+            if (restore.getBoolean("enabled")) ctx.startForegroundService(new Intent(ctx, AirPlayService.class).setAction(AirPlayService.ACTION_START_SERVER));
+            else ctx.stopService(new Intent(ctx, AirPlayService.class));
+        }
+    }
+    private AirPlayService service() { return AirPlayService.Companion.getInstance(); }
+    private void require(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+        checks++; report.append("PASS ").append(message).append('\n');
+    }
+}
