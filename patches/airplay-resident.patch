@@ -0,0 +1,58 @@
+package io.github.jqssun.airplay
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.net.Uri
+import android.os.Bundle
+import android.provider.Settings
+import io.github.jqssun.airplay.service.AirPlayService
+
+/** Launcher control surface; guarded by a signature permission in the manifest. */
+class AirPlayControlProvider : ContentProvider() {
+    override fun onCreate() = true
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        require(method == "status" || method == "configure") { "Unknown AirPlay operation" }
+        val ctx = requireNotNull(context)
+        // ContentProvider.call does not infer URI read/write permission checks.
+        ctx.enforceCallingOrSelfPermission("dev.aurora.tv.permission.CONTROL_AIRPLAY", "AirPlay control requires the paired launcher")
+        val prefs = ctx.getSharedPreferences(Prefs.NAME, 0)
+        if (method == "configure") {
+            val edit = prefs.edit()
+            if (extras?.containsKey("enabled") == true) {
+                val enabled = extras.getBoolean("enabled")
+                edit.putBoolean(Prefs.RECEIVER_ENABLED, enabled)
+                    .putBoolean(Prefs.AUTO_START, enabled).putBoolean(Prefs.BOOT_AUTO_START, enabled)
+                if (enabled) edit.putBoolean(Prefs.RUN_IN_BACKGROUND, true)
+                    .putBoolean(Prefs.LAUNCH_ON_CONNECT, true).putBoolean(Prefs.AUTO_FULLSCREEN, true)
+            }
+            if (extras?.containsKey("name") == true) {
+                val name = extras.getString("name", "").trim()
+                require(name.isNotEmpty() && name.length <= 40 && name.none { it.isISOControl() }) { "Invalid receiver name" }
+                edit.putString(Prefs.SERVER_NAME, name)
+            }
+            if (extras?.containsKey("require_pin") == true) edit.putBoolean(Prefs.REQUIRE_PIN, extras.getBoolean("require_pin"))
+            check(edit.commit()) { "Cannot save AirPlay settings" }
+            if (extras?.containsKey("enabled") == true && !extras.getBoolean("enabled")) {
+                android.os.Handler(android.os.Looper.getMainLooper()).post {
+                    AirPlayService.instance?.applyDisabledState()
+                }
+            }
+        }
+        return Bundle().apply {
+            putInt("protocol", 1)
+            putBoolean("enabled", prefs.getBoolean(Prefs.RECEIVER_ENABLED, Prefs.DEF_RECEIVER_ENABLED))
+            putString("name", prefs.getString(Prefs.SERVER_NAME, Prefs.DEF_SERVER_NAME))
+            putBoolean("require_pin", prefs.getBoolean(Prefs.REQUIRE_PIN, Prefs.DEF_REQUIRE_PIN))
+            putBoolean("overlay", Settings.canDrawOverlays(ctx))
+            val service = AirPlayService.instance
+            putString("state", service?.serverState?.value?.name ?: "STOPPED")
+            putBoolean("casting", service?.let { it.mirroringActive.value || it.videoPlaybackActive.value || (it.audioOnly.value && it.connectionCount.value > 0) } ?: false)
+        }
+    }
+    override fun query(uri: Uri, projection: Array<out String>?, selection: String?, selectionArgs: Array<out String>?, sortOrder: String?): Cursor? = null
+    override fun getType(uri: Uri): String? = null
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?) = 0
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?) = 0
+}
